; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that change here are also those changed in the editor.

[application]

config/name="Among Us 3D"
config/description="High-fidelity 3D multiplayer Among Us clone with holographic map and complete role system"
config/version="0.1.0"
config/windows_native_icon="res://assets/icon.svg"
config/macos_native_icon="res://assets/icon.svg"

[debug]

gdscript/warnings/unused_variable=1
gdscript/warnings/unused_signal=1
gdscript/warnings/return_value_discarded=1

[display]

